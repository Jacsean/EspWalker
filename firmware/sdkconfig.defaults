# Esp32Walker 项目基线配置（会覆盖为 sdkconfig）
# 引脚默认值见 main/Kconfig.projbuild；此处只固化关键项。

# --- 芯片与 Flash ---
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y

# --- 分区表 ---
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# --- PSRAM（摄像头帧缓冲必需）---
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y

# --- 日志 ---
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_LOG_MAXIMUM_LEVEL_DEBUG=y

# --- 任务栈与稳定性 ---
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_FREERTOS_CHECK_STACKOVERFLOW_CANARY=y
CONFIG_FREERTOS_INTERRUPT_BACKTRACE=y

# --- Esp32Walker 应用开关 ---
CONFIG_APP_ROLE_MASTER=y
CONFIG_APP_CHASSIS_TYPE="diff2"
CONFIG_APP_ENABLE_CAMERA=n
CONFIG_APP_ENABLE_AUDIO=n
CONFIG_APP_ENABLE_WAKE=n
CONFIG_APP_ENABLE_STATUS_LED=y
CONFIG_APP_ENABLE_IMU=y

# --- 网络（改这里，或 menuconfig）---
CONFIG_APP_WIFI_SSID="your-ssid"
CONFIG_APP_WIFI_PASS="your-pass"
CONFIG_APP_SERVER_IP="192.168.1.100"
CONFIG_APP_SERVER_PORT=8888

# --- 避障阈值（cm）---
CONFIG_APP_PROX_STOP_CM=15
CONFIG_APP_PROX_SLOW_CM=30
